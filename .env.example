# ---------------------------------------------------------------------------
# Copy to .env.local for local `vercel dev`.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# A PUBLIC_ prefix is the only way a value reaches the browser. Everything else
# is server-only and must never be exposed.
# ---------------------------------------------------------------------------

# Public (safe to ship in the HTML/JS bundle)
PUBLIC_SITE_URL=https://your-project.vercel.app
# Leave blank to disable Turnstile entirely. The form still validates,
# honeypots and rate-limits server-side.
PUBLIC_TURNSTILE_SITE_KEY=

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Resend → API Keys
RESEND_API_KEY=re_YOUR_KEY
CONTACT_TO_EMAIL=you@example.com
# Use onboarding@resend.dev while testing; switch to a verified domain later.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Cloudflare Turnstile → Widget Settings (server-side secret)
TURNSTILE_SECRET_KEY=

# Secret used to HMAC the caller IP before hashing/storing it. Generate with:
#   openssl rand -hex 32
IP_HASH_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_STRING

# Rate limit: max hits per window, per hashed IP
RATE_MAX=3
RATE_WINDOW_SECONDS=600
