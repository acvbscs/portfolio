{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "api/**/*", "astro.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
