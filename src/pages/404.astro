---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title={site.notFound.code} path="/404" noindex={true}>
  <div class="notfound">
    <div class="notfound-inner">
      <p class="notfound-code" aria-hidden="true">{site.notFound.code}</p>
      <h1 class="notfound-title">ERR {site.notFound.code} — {site.notFound.title}</h1>
      <p class="notfound-message">{site.notFound.message}</p>
      <a class="button-quiet" href="/">
        {site.notFound.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>
