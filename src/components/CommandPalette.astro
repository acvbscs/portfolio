---
// Markup only. Commands and behaviour are wired in src/scripts/runtime.ts.
---

<div class="palette" data-palette hidden>
  <div class="palette-backdrop" data-palette-close aria-hidden="true"></div>

  <div class="palette-panel" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="palette-input-row">
      <span class="palette-prompt mono" aria-hidden="true">:</span>
      <input
        class="palette-input"
        type="text"
        data-palette-input
        placeholder="Type a command…"
        aria-label="Command"
        aria-controls="palette-list"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>esc</kbd>
    </div>

    <ul class="palette-list" id="palette-list" role="listbox" aria-label="Commands" data-palette-list>
    </ul>

    <p class="palette-foot mono">j / k move · enter select · esc close</p>
  </div>
</div>
