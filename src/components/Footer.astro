---
import { site } from '../site.config';

const social = [
  { label: 'GitHub', href: site.links.github },
  { label: 'GitLab', href: site.links.gitlab },
  { label: 'Instagram', href: site.links.instagram },
  { label: 'Discord', href: site.links.discord },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Email', href: site.links.email }
].filter((link) => link.href.trim() !== '');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <p class="footer-statement">{site.footer.statement}</p>
      <p class="footer-status mono">
        <span class="dim">{site.footer.statusLabel}</span>
        <span>{site.footer.status}</span>
      </p>
    </div>

    <hr class="rule" />

    <div class="footer-bottom">
      <ul class="footer-links">
        {social.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>

      <div class="footer-meta mono">
        <span>{site.build.codename} / v{site.build.version}</span>
        <time
          datetime={site.footer.statusUpdated}
          data-relative-date
          data-date={site.footer.statusUpdated}
        >
          last touched {site.footer.statusUpdated}
        </time>
        <a href="/colophon">{site.footer.colophon}</a>
        <a href="/privacy">Privacy</a>
        <button
          class="secret-trigger"
          type="button"
          data-secret-open
          aria-label="Open hidden note"
        >
          [{site.secrets.hint}]
        </button>
        <span class="footer-eof" aria-hidden="true">// EOF</span>
      </div>
    </div>
  </div>
</footer>

<div class="secret-panel" data-secret-panel hidden>
  <div class="secret-card" role="dialog" aria-modal="true" aria-labelledby="secret-title">
    <h2 class="secret-title" id="secret-title">{site.secrets.decodedTitle}</h2>
    <p class="secret-text" data-secret-text></p>
    <button class="secret-close" type="button" data-secret-close>esc / close</button>
  </div>
</div>
