---
import { site } from '../site.config';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>

      <h1 class="hero-title" id="hero-title">
        {site.hero.display.map((line) => <span class="hero-line">{line}</span>)}
      </h1>

      <p class="hero-lede measure">{site.hero.lede}</p>

      <div class="hero-actions">
        <a class="button" href={site.hero.primaryCta.href}>
          {site.hero.primaryCta.label}
          <span aria-hidden="true">↗</span>
        </a>
        <span class="hero-hint mono">{site.hero.hint}</span>
      </div>
    </div>

    <div class="hero-mark" aria-hidden="true">
      <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="28" y="28" width="184" height="184" stroke="currentColor" stroke-width="1" opacity="0.5" />
        <rect x="64" y="64" width="112" height="112" stroke="currentColor" stroke-width="1" opacity="0.28" />
        <path d="M120 0v52M120 188v52M0 120h52M188 120h52" stroke="currentColor" stroke-width="1" opacity="0.5" />
        <path d="M28 96h24M28 144h24M188 96h24M188 144h24M96 28v24M144 28v24M96 188v24M144 188v24" stroke="currentColor" stroke-width="1" opacity="0.32" />
        <path d="M104 104h32v32h-32z" stroke="currentColor" stroke-width="1" opacity="0.45" />
        <circle class="mark-dot" cx="120" cy="120" r="3.5" />
      </svg>
    </div>
  </div>
</section>
